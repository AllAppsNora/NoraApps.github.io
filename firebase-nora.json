{
  "hosting": [
    {
      "site": "noraapps",
      "public": "portal",
      "ignore": [
        "**/.*"
      ]
    },
    {
      "site": "noword",
      "public": "noword-source",
      "ignore": [
        "**/.*"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/app/",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
